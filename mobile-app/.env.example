# ============================================================
# Baladi mobile app (Expo) — environment template
# Copy to `.env` and load via expo-constants / app.config.ts.
#
# The current `app.json` keeps `extra.apiUrl` inline for
# convenience. For production builds, override either by:
#   1. Editing app.json before `eas build`, OR
#   2. Setting EXPO_PUBLIC_API_URL on the build environment
#      and reading it from app.config.ts.
# ============================================================

# API backend base URL (no trailing slash)
EXPO_PUBLIC_API_URL=https://api.lb-baladiyati.com

# Sentry (optional)
EXPO_PUBLIC_SENTRY_DSN=

{
  "expo": {
    "name": "Baladi",
    "slug": "baladi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "baladi",
    "extra": {
      "apiUrl": "http://localhost:3000",
      "sentryDsn": "",
      "sentryEnvironment": "development",
      "router": {},
      "eas": {
        "projectId": "98eeb9c7-de00-44f6-b8f9-18eea9d6af87"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lbbaladiyati.app",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to take photos of issues.",
        "NSLocationWhenInUseUsageDescription": "We need your location to report issues accurately.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to attach images to complaints."
      }
    },
    "android": {
      "package": "com.lbbaladiyati.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0c1a2e"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Baladi to access your photos to attach to complaints."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Baladi to use your location to report issues accurately."
        }
      ],
      "expo-font"
    ]
  }
}

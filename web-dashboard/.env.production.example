# ============================================================
# Baladi web dashboard (Next.js) — PRODUCTION template
# ------------------------------------------------------------
# Copy to `.env.production` on the build machine before
# `npm run build`. NEXT_PUBLIC_* values are baked into the
# client bundle at build time, so DO NOT set them at runtime.
# ============================================================

NEXT_PUBLIC_API_URL=https://api.lb-baladiyati.com

# Optional Sentry DSN for the browser bundle.
# NEXT_PUBLIC_SENTRY_DSN=

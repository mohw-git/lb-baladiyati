# ============================================================
# Baladiyati web dashboard (Next.js) — PRODUCTION build template
# ------------------------------------------------------------
# Copy to .env.production before `npm run build` on the server.
# NEXT_PUBLIC_* values are baked into the client bundle at build time.
# ============================================================

NEXT_PUBLIC_API_URL=https://api.lb-baladiyati.com

# Optional
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ============================================================
# Baladi backend (NestJS) — DEVELOPMENT environment template
# ------------------------------------------------------------
#  - Copy this file to `.env`  (NEVER commit `.env`)
#  - Real secrets must NEVER appear in this file or any *.example
#  - For production, see `.env.production.example`
#  - The application FAILS FAST in production if any value below
#    is left as the placeholder shown here. See src/core/config/
#    production-validator.ts for the full list of checks.
# ============================================================

NODE_ENV=development
PORT=3000

# PostgreSQL connection string. The dev default below uses the
# postgres superuser — DO NOT use that role in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/baladi

# Long random string (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRATION=7d

# Local file uploads. In production this MUST be an absolute
# path on a persistent disk that is included in your backup plan.
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ── Public URLs (used in email links, CORS, etc.) ────────────
# Dev defaults use localhost. The validator blocks production
# startup if any of these still point to localhost.
APP_PUBLIC_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ── CORS allowlist ───────────────────────────────────────────
# Comma-separated origins. Leave blank in dev (FRONTEND_URL +
# common dev ports auto-allowed). In production set explicitly,
# e.g. CORS_ORIGINS=https://lb-baladiyati.com
CORS_ORIGINS=

# ── Firebase Cloud Messaging ─────────────────────────────────
# Place the JSON outside the repo OR inside the gitignored
# `secrets/` folder. NEVER commit a service-account JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase/admin-service-account.json
# Alternative: inline JSON on a single line.
# FIREBASE_SERVICE_ACCOUNT=

# ── Email (Resend preferred) ─────────────────────────────────
# Get a key at https://resend.com.  Paste your real key into
# `.env` only. Never commit a real key.
RESEND_API_KEY=
MAIL_FROM=noreply@mail.lb-baladiyati.com
MAIL_FROM_NAME=Baladi
MAIL_REPLY_TO=support@lb-baladiyati.com

# ── SMTP fallback (only used if RESEND_API_KEY is empty) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Observability ────────────────────────────────────────────
# Sentry — leave empty to disable.
SENTRY_DSN=

# Swagger — set to "true" to expose /api in production (off by default).
ENABLE_SWAGGER=false

# Pino log level (debug | info | warn | error)
LOG_LEVEL=

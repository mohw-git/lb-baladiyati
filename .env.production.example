# ============================================================
# Baladi backend (NestJS) — PRODUCTION environment template
# ------------------------------------------------------------
# Copy to C:\baladiyati\app\.env on the Windows Server (NEVER commit).
# Replace every CHANGE_ME / placeholder before first boot.
# Startup validator refuses unsafe placeholders and localhost URLs.
# ============================================================

NODE_ENV=production
PORT=3000

# PostgreSQL — dedicated app user (not postgres superuser).
DATABASE_URL=postgresql://baladi_app:CHANGE_ME_DB_PASSWORD@localhost:5432/baladi

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRATION=7d

# Persistent uploads (absolute path on server disk).
UPLOAD_PATH=C:\baladiyati\data\uploads
MAX_FILE_SIZE=10485760

# Public URLs (HTTPS only in production).
APP_PUBLIC_URL=https://lb-baladiyati.com
API_PUBLIC_URL=https://api.lb-baladiyati.com
FRONTEND_URL=https://lb-baladiyati.com

# Web dashboard origin for CORS (comma-separated if multiple).
CORS_ORIGINS=https://lb-baladiyati.com

# Firebase Admin SDK — file outside git; lock NTFS permissions.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\baladiyati\secrets\firebase-adminsdk.json
# Alternative: FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Email (Resend preferred).
RESEND_API_KEY=re_CHANGE_ME
MAIL_FROM=noreply@mail.lb-baladiyati.com
MAIL_FROM_NAME=Baladi
MAIL_REPLY_TO=support@lb-baladiyati.com

# SMTP fallback (leave empty when using Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
GIT_COMMIT_SHA=
ENABLE_SWAGGER=false
LOG_LEVEL=info

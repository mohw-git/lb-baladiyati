# ============================================================
# Baladi backend (NestJS) — PRODUCTION environment template
# ------------------------------------------------------------
#  - Copy to `.env` on the production server (NEVER commit).
#  - Replace every value marked REQUIRED / REPLACE before boot.
#  - The startup validator (src/core/config/production-validator.ts)
#    will refuse to start the app if any placeholder below is left
#    in place, if URLs still resolve to localhost, or if JWT_SECRET
#    is shorter than 32 chars.
#  - Keep this file outside any git repo, and lock down its file
#    permissions to the service account user only.
# ============================================================

NODE_ENV=production
PORT=3000

# ── Database ─────────────────────────────────────────────────
# Use a non-superuser PostgreSQL role with the minimum privileges
# the app needs (CRUD + DDL on the baladi schema).
DATABASE_URL=postgresql://baladi_app:REPLACE_WITH_DB_PASSWORD@localhost:5432/baladi

# ── JWT ──────────────────────────────────────────────────────
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotate periodically (forces all users to re-login).
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRATION=7d

# ── File uploads ─────────────────────────────────────────────
# REQUIRED on Windows Server: absolute path on a backed-up disk.
UPLOAD_PATH=C:\baladi\data\uploads
MAX_FILE_SIZE=10485760

# ── Public URLs ──────────────────────────────────────────────
# These are baked into outgoing email links and OAuth callbacks.
# The validator REFUSES to boot the app in production if any of
# these point to localhost or 127.0.0.1.
APP_PUBLIC_URL=https://lb-baladiyati.com
API_PUBLIC_URL=https://api.lb-baladiyati.com
FRONTEND_URL=https://lb-baladiyati.com

# ── CORS allowlist ───────────────────────────────────────────
# Comma-separated. Should include FRONTEND_URL exactly.
# Mobile-app requests have no Origin header and are always allowed.
CORS_ORIGINS=https://lb-baladiyati.com

# ── Firebase Cloud Messaging ─────────────────────────────────
# REQUIRED for mobile push notifications.
# Service-account JSON MUST be outside the repo OR inside the
# gitignored `secrets/` folder. Lock filesystem permissions to
# the service account user only.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\baladi\app\secrets\firebase\admin-service-account.json
# Alternative (inline JSON, single line):
# FIREBASE_SERVICE_ACCOUNT=

# ── Email (Resend) ───────────────────────────────────────────
# REQUIRED in production. The validator refuses to boot if empty.
# IMPORTANT: if your Resend key has ever been committed to git or
# pasted in a chat/log, rotate it at https://resend.com/api-keys
# BEFORE going live.
RESEND_API_KEY=re_REPLACE_WITH_REAL_KEY
MAIL_FROM=noreply@mail.lb-baladiyati.com
MAIL_FROM_NAME=Baladi
MAIL_REPLY_TO=support@lb-baladiyati.com

# SMTP fallback — leave empty when using Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=
ENABLE_SWAGGER=false
LOG_LEVEL=info
